# Copy to compose.env (gitignored). Topology only: service DNS names and host ports.
# Laravel: backend/.env.example → backend/.env
# Next.js: frontend/.env.example → frontend/.env
#
# docker compose --env-file compose.env up --build

POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

API_HOST=api
API_PORT=9000

NGINX_HOST=nginx
NGINX_PORT=8000

WEB_HOST=web
WEB_PORT=3000
